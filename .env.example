ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override the model used for "Evaluate" scoring (defaults to claude-haiku-4-5-20251001)
# ANTHROPIC_MODEL=claude-sonnet-5

# Optional: enables "Add from Drive" on the Previous Knowledge file field.
# From Google Cloud Console: OAuth 2.0 Client ID (Web application, with
# http://localhost:8934 as an authorized JavaScript origin) + an API key
# restricted to the Picker API.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_API_KEY=your-api-key
