ANTHROPIC_API_KEY=sk-ant-your-key-here

# Hosted pilot: use Render's secret settings, not an uploaded .env file.
# See DEPLOYMENT.md. Pilot mode requires a random 20-200 character password.
# Browser sign-in username: pilot
# RPA_PILOT_MODE=true
# RPA_PILOT_PASSWORD=replace-with-a-random-password
# AI stays off in pilot mode until enabled after the provider budget is checked.
# RPA_AI_ENABLED=false

# Private completed-plan submission is independently off by default. Read
# SUBMISSIONS.md and finish its operational/provider checks before enabling.
# These are server/operator settings; never put storage secrets in browser code.
# RPA_SUBMISSIONS_ENABLED=false
# RPA_SUBMISSIONS_ACCESS=pilot
# RPA_SUBMISSIONS_DEPLOYMENT=approved-deployment-id
# RPA_SUBMISSIONS_COHORT=approved-cohort-id
# RPA_SUBMISSIONS_POLICY_VERSION=approved-notice-version
# RPA_SUBMISSIONS_NOTICE=Full approved collection notice including operators, purpose, access, retention and deletion contact.
# RPA_R2_ACCOUNT_ID=your-32-character-cloudflare-account-id
# RPA_R2_BUCKET=private-bucket-name
# RPA_R2_ACCESS_KEY_ID=server-side-bucket-scoped-key
# RPA_R2_SECRET_ACCESS_KEY=server-side-secret
# Operator shell only, separate from runtime configuration:
# RPA_SUBMISSIONS_MAINTENANCE=true
# RPA_BACKUP_PASSPHRASE=use-a-separate-secret-from-your-password-manager

# Optional: override the model used for "Evaluate" scoring (defaults to claude-haiku-4-5-20251001)
# ANTHROPIC_MODEL=claude-sonnet-5

# Optional: enables "Add from Drive" on the Previous Knowledge file field.
# From Google Cloud Console: OAuth 2.0 Client ID (Web application, with
# http://localhost:8934 as an authorized JavaScript origin) + an API key
# restricted to the Picker API.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_API_KEY=your-api-key

# Optional: enables the Jira ticket search connector on any text field the
# template marks "jira". None is today: the project field asks for a project
# name since RPA-119. JIRA_BASE_URL is your Jira Cloud site (e.g.
# https://yourcompany.atlassian.net). JIRA_EMAIL is the Atlassian account
# email tied to the token below. JIRA_API_TOKEN is created at
# https://id.atlassian.com/manage-profile/security/api-tokens — the token
# stays server-side only, never sent to the browser.
# JIRA_BASE_URL=https://yourcompany.atlassian.net
# JIRA_EMAIL=you@yourcompany.com
# JIRA_API_TOKEN=your-api-token
